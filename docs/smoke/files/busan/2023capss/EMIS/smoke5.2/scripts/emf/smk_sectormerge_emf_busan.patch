+      if ( $?RUN_SDATE && $?RUN_EDATE ) then
+         if ( $juldate < $RUN_SDATE || $juldate > $RUN_EDATE ) continue
+      endif
 
       ## Reset RUN_MRGGRID and RUN_M3STAT before calling runsettings.csh
       setenv RUN_MRGGRID Y
