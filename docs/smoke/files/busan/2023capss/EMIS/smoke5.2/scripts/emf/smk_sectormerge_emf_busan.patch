       set juldate = `$IOAPIDIR/juldate $mon $day $year | /bin/grep $year | cut -d, -f2`
       setenv G_STDATE $juldate
+      # --- Busan patch (2026-11-24): limit merge dates to the MCIP period RUN_SDATE..RUN_EDATE (YYYYDDD)
